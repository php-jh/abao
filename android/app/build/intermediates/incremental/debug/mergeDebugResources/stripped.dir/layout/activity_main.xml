<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:padding="@dimen/activity_padding">

    <!-- 左侧：阿宝智能体 -->
    <LinearLayout
        android:id="@+id/agentPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="300dp"
        app:layout_constraintWidth_percent="0.31">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_brand_mark"
                android:gravity="center"
                android:text="🐼"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/brandTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/brand_title"
                android:textColor="@color/brand_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pandaStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="@dimen/panda_stage_padding_bottom">

            <View
                android:id="@+id/pandaShadow"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginStart="@dimen/panda_shadow_margin_h"
                android:layout_marginEnd="@dimen/panda_shadow_margin_h"
                android:layout_marginBottom="@dimen/panda_shadow_margin_bottom"
                android:background="@drawable/bg_panda_shadow" />

            <ImageView
                android:id="@+id/pandaAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/panda_avatar_margin_bottom"
                android:adjustViewBounds="true"
                android:contentDescription="@string/agent_online"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/pandaAvatarFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/panda_avatar_margin_bottom"
                android:gravity="center"
                android:text="🐼"
                android:textSize="108sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/agentCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/agent_card_margin_top"
            android:minHeight="70dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/agent_card_padding_h"
            android:paddingVertical="@dimen/agent_card_padding_v">

            <View
                android:layout_width="12dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_section_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/agentOnlineTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_online"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/agentHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/agent_hint_default"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧：课程演练 -->
    <LinearLayout
        android:id="@+id/lessonPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/lesson_panel_gap"
        android:clipChildren="true"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/agentPanel"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabWarmup"
                style="@style/TabButton.Active"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/tab_warmup" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabPractice"
                style="@style/TabButton"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/tab_practice" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabChallenge"
                style="@style/TabButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/tab_challenge" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <!-- 课前热身：标题固定，词卡网格由 RecyclerView 独立滚动 -->
            <LinearLayout
                android:id="@+id/panelWarmup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <include
                    android:id="@+id/warmupSectionTitle"
                    layout="@layout/include_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/wordGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingBottom="12dp"
                    android:scrollbars="vertical" />
            </LinearLayout>

            <!-- 课中演练：整块可滚动，右侧显示加粗滚动条，底部学生回答可拖出 -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/panelPractice"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:fillViewport="false"
                android:padding="@dimen/card_padding"
                android:scrollbarSize="@dimen/panel_scrollbar_size"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbarThumbVertical="@drawable/scrollbar_thumb_vertical"
                android:scrollbars="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_section_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/practice_title"
                            android:textColor="@color/ink"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <Spinner
                            android:id="@+id/scenarioSelect"
                            android:layout_width="@dimen/scenario_spinner_width"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_scenario_spinner"
                            android:contentDescription="@string/scenario_label"
                            android:popupBackground="@color/white"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/scenario_strip_margin_top"
                        android:layout_marginBottom="@dimen/scenario_strip_margin_bottom"
                        android:background="@drawable/bg_scenario_strip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/current_scenario"
                                android:textColor="@color/muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/scenarioTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hintButton"
                            style="@style/GhostButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/hint" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/translateButton"
                            style="@style/GhostButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/translate_help" />
                    </LinearLayout>

                    <!-- 对话区：内层独立滑轮；与外层 panelPractice 通过 NestedScroll 协调，互不抢手势 -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dialogue_height"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_dialogue_panel">

                        <androidx.core.widget.NestedScrollView
                            android:id="@+id/dialogueScroll"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:contentDescription="@string/dialogue_live_region"
                            android:fadeScrollbars="false"
                            android:fillViewport="false"
                            android:overScrollMode="ifContentScrolls"
                            android:paddingStart="@dimen/dialogue_panel_padding_h"
                            android:paddingTop="@dimen/dialogue_panel_padding_v"
                            android:paddingEnd="4dp"
                            android:paddingBottom="@dimen/dialogue_panel_padding_v"
                            android:scrollbarSize="@dimen/dialogue_scrollbar_size"
                            android:scrollbarStyle="insideOverlay"
                            android:scrollbarThumbVertical="@drawable/scrollbar_thumb_vertical"
                            android:scrollbars="vertical">

                            <LinearLayout
                                android:id="@+id/dialogueContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="yes"
                                android:orientation="vertical"
                                android:paddingEnd="4dp" />
                        </androidx.core.widget.NestedScrollView>
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#D8E1EF" />

                    <LinearLayout
                        android:id="@+id/recordingArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/transcriptBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:labelFor="@id/studentInput"
                                android:text="@string/student_answer"
                                android:textColor="#56667B"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/studentInput"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/student_input_height"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_input"
                                android:gravity="top|start"
                                android:hint="@string/input_placeholder"
                                android:inputType="textMultiLine|textCapSentences"
                                android:minHeight="96dp"
                                android:padding="14dp"
                                android:textColor="@color/ink"
                                android:textColorHint="@color/muted"
                                android:textSize="17sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/recordingControls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/speakPromptButton"
                                android:layout_width="@dimen/control_button_height"
                                android:layout_height="@dimen/control_button_height"
                                android:background="@drawable/bg_practice_play_button"
                                android:contentDescription="@string/play_prompt"
                                android:insetLeft="0dp"
                                android:insetRight="0dp"
                                android:minWidth="@dimen/control_button_height"
                                android:padding="0dp"
                                android:text="▶"
                                android:textColor="@color/teal"
                                android:textSize="18sp"
                                app:backgroundTint="@null"
                                app:strokeWidth="0dp" />

                            <Button
                                android:id="@+id/recordButton"
                                style="@style/PracticeRecordButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/practice_control_button_height"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_practice_record_button"
                                android:backgroundTint="@null"
                                android:stateListAnimator="@null"
                                android:text="@string/record_start" />

                            <Button
                                android:id="@+id/finishButton"
                                style="@style/PracticeFinishButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/practice_control_button_height"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_success_button"
                                android:backgroundTint="@null"
                                android:stateListAnimator="@null"
                                android:text="@string/finish_reading" />
                        </LinearLayout>
                    </LinearLayout>

                    <include
                        android:id="@+id/feedbackPanel"
                        layout="@layout/layout_feedback_panel" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- 课后挑战 -->
            <ScrollView
                android:id="@+id/panelChallenge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:fillViewport="true"
                android:padding="@dimen/card_padding"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/challengeSectionTitle"
                        layout="@layout/include_section_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/challengeImage"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/challenge_image_height"
                            android:layout_marginEnd="16dp"
                            android:layout_weight="1.1"
                            android:contentDescription="@string/challenge_heading"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.9"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/challenge_heading"
                                android:textColor="@color/ink"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:lineSpacingMultiplier="1.7"
                                android:text="@string/challenge_body"
                                android:textColor="#5E6C7F"
                                android:textSize="17sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
