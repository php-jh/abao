<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feedbackPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/bg_dashed_divider" />

    <LinearLayout
        android:id="@+id/feedbackContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 列1：综合分 + 语速（对应 .score-hero） -->
        <LinearLayout
            android:id="@+id/feedbackScoreColumn"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:background="@drawable/bg_score_ring"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/totalScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_score_label"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_speed_meter">

                    <View
                        android:id="@+id/speedNeedle"
                        android:layout_width="4dp"
                        android:layout_height="42dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:background="#EF3F46"
                        android:pivotX="0.5"
                        android:pivotY="1.0"
                        android:rotation="-62" />
                </FrameLayout>

                <TextView
                    android:id="@+id/speedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="@color/ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wpm_label"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 列2：七项指标（对应 .metric-list） -->
        <LinearLayout
            android:id="@+id/feedbackMetricColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:id="@+id/metricList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 列3：AI 解析（对应 .analysis） -->
        <LinearLayout
            android:id="@+id/feedbackAnalysisColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_analysis"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/analysisText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="#4F5E70"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/correctionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_correction"
                android:lineSpacingMultiplier="1.45"
                android:padding="12dp"
                android:textColor="@color/correction_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
