<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:padding="14dp">

    <!-- 左侧：阿宝智能体 -->
    <LinearLayout
        android:id="@+id/agentPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.28">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_brand_mark"
                android:gravity="center"
                android:text="🐼"
                android:textSize="16sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/brand_title"
                android:textColor="@color/brand_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingVertical="8dp">

            <View
                android:layout_width="220dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_panda_shadow" />

            <ImageView
                android:id="@+id/pandaAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/agent_online"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/pandaAvatarFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🐼"
                android:textSize="96sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <View
                android:layout_width="12dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_section_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_online"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/agentHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/agent_hint_default"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧：课程演练 -->
    <LinearLayout
        android:id="@+id/lessonPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/agentPanel"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabWarmup"
                style="@style/TabButton.Active"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/tab_warmup" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabPractice"
                style="@style/TabButton"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/tab_practice" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabChallenge"
                style="@style/TabButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/tab_challenge" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <!-- 课前热身 -->
            <ScrollView
                android:id="@+id/panelWarmup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:fillViewport="true"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/warmupSectionTitle"
                        layout="@layout/include_section_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/wordGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </ScrollView>

            <!-- 课中演练 -->
            <ScrollView
                android:id="@+id/panelPractice"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:fillViewport="true"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_section_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/practice_title"
                            android:textColor="@color/ink"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/scenarioSelect"
                            android:contentDescription="@string/scenario_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_scenario_strip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/current_scenario"
                                android:textColor="@color/muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/scenarioTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hintButton"
                            style="@style/GhostButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/hint" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/translateButton"
                            style="@style/GhostButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/translate_help" />
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/dialogueScroll"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/dialogue_live_region"
                        android:scrollbars="vertical">

                        <LinearLayout
                            android:id="@+id/dialogueContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="yes"
                            android:orientation="vertical" />
                    </ScrollView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#D8E1EF" />

                    <LinearLayout
                        android:id="@+id/recordingArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/transcriptBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/student_answer"
                        android:labelFor="@id/studentInput"
                        android:textColor="#56667B"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/studentInput"
                        android:layout_width="match_parent"
                        android:layout_height="88dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:gravity="top|start"
                        android:hint="@string/input_placeholder"
                        android:inputType="textMultiLine|textCapSentences"
                        android:padding="12dp"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recordingControls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/speakPromptButton"
                            style="@style/GhostButton"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:contentDescription="@string/play_prompt"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:minWidth="46dp"
                            android:padding="0dp"
                            android:text="▶" />

                        <Button
                            android:id="@+id/recordButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_teal_button"
                            android:text="@string/record_start"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/finishButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_success_button"
                            android:text="@string/finish_reading"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                    </LinearLayout>
                    </LinearLayout>

                    <include
                        android:id="@+id/feedbackPanel"
                        layout="@layout/layout_feedback_panel" />
                </LinearLayout>
            </ScrollView>

            <!-- 课后挑战 -->
            <ScrollView
                android:id="@+id/panelChallenge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:fillViewport="true"
                android:padding="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/challengeSectionTitle"
                        layout="@layout/include_section_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/challengeImage"
                            android:layout_width="0dp"
                            android:layout_height="200dp"
                            android:layout_marginEnd="16dp"
                            android:layout_weight="1.1"
                            android:contentDescription="@string/challenge_heading"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.9"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/challenge_heading"
                                android:textColor="@color/ink"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:lineSpacingMultiplier="1.7"
                                android:text="@string/challenge_body"
                                android:textColor="#5E6C7F"
                                android:textSize="17sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
