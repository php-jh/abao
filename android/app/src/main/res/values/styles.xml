<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/soft</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="colorPrimary">@color/blue</item>
        <item name="colorPrimaryVariant">@color/deep_blue</item>
        <item name="colorAccent">@color/teal</item>
    </style>

    <style name="TabButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">999dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/deep_blue</item>
        <item name="backgroundTint">@color/white</item>
    </style>

    <style name="TabButton.Active">
        <item name="backgroundTint">@color/deep_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="GhostButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">999dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/deep_blue</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/white</item>
    </style>
</resources>
